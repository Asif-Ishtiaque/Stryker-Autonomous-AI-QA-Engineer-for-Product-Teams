# Root .env consumed by `docker compose up`. Copy to .env before starting.
# Service-to-service hostnames (postgres, redis, chroma, minio, ...) are set
# directly in docker-compose.yml — only cross-cutting secrets/config live here.

JWT_SECRET=change-me-to-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64-fernet-key

FRONTEND_URL=http://localhost:3000

# LLM provider: ollama | vllm | lmstudio | openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_API_KEY=not-needed

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Generate both secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
