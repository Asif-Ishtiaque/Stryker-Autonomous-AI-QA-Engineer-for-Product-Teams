# Copy to .env and adjust. Docker Compose injects most of these automatically;
# this file matters most when running the backend outside Compose.

ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

JWT_SECRET=change-me-to-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64-fernet-key

DATABASE_URL=postgresql+asyncpg://stryker:stryker@localhost:5432/stryker

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CHROMA_HOST=localhost
CHROMA_PORT=8000

MINIO_ENDPOINT=localhost:9000
# Browser-reachable endpoint used only for signing presigned evidence URLs — same as
# MINIO_ENDPOINT here since everything's on localhost already outside Docker.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=stryker
MINIO_SECRET_KEY=stryker-secret
MINIO_SECURE=false

OPENSEARCH_URL=http://localhost:9200

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_TRACING=false

# LLM provider: ollama | vllm | lmstudio | openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
# Per-call timeout. Local CPU inference can take 60-150s+ per call; lower this for a fast
# hosted API where a hung request should fail fast instead.
LLM_REQUEST_TIMEOUT_SECONDS=300

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

BROWSER_POOL_SIZE=4
BROWSER_HEADLESS=true
# Hard ceiling (seconds) on a single run's Celery task. Local CPU LLM inference is slow —
# lower this for a fast hosted API, raise it further for very slow local hardware.
RUN_TASK_TIME_LIMIT_SECONDS=1800
